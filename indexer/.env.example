# OrdNET Indexer Environment Variables
# Copy this to .env and fill in values

# RPC URL for LitVM (or other EVM chain where OrdinalReassembler is deployed)
# Preferred: LITVM_RPC_URL (for consistency with Hardhat config)
LITVM_RPC_URL=https://testnet.litvm.com
# Fallback (legacy)
RPC_URL=https://your-litvm-rpc.example.com

# Private key for the wallet that will submit data to the contract (NEVER commit real keys)
PRIVATE_KEY=0xYourPrivateKeyHere

# Address of the deployed OrdinalReassemblerV2 contract
CONTRACT_ADDRESS=0x5F794363553884E9AeaD019Fb436C7a2c1634578

# Comma-separated list of Ordinal inscription IDs to index (e.g. the content URL path)
# Format: <txid>i<vout>  -- the part after /content/
ORDINAL_INSCRIPTION_IDS=8e7045fdfc041122c36443f5709edb613494a75f760ec318de911555bb1bfb78i0

# Re-sync interval in milliseconds (e.g. 300000 = 5 minutes)
SYNC_INTERVAL_MS=300000

# Optional: Logging level (debug, info, warn, error)
LOG_LEVEL=info
